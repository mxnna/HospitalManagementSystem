<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>


<!--<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hospitalmanagementsystem.AboutUsController">
    
</AnchorPane>-->

<ScrollPane fitToWidth="true"
            xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@../design/about us.css">


    <content>
        <VBox spacing="25" prefWidth="900"
              style="-fx-background-color: #f5f7fb;">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Title -->
            <VBox spacing="5">
                <Label text="About Us">
                    <font>
                        <Font size="26"/>
                    </font>
                </Label>
                <Label text="Hospital information and internal resources"
                       style="-fx-text-fill: #777;"/>
            </VBox>

            <!-- Our Mission -->
            <VBox spacing="10"
                  style="-fx-background-color: white; -fx-background-radius: 10;">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <Label text="Our Mission">
                    <font>
                        <Font size="18"/>
                    </font>
                </Label>

                <Label wrapText="true"
                       text="To provide exceptional healthcare services with compassion, innovation, and excellence. We are committed to improving the health and well-being of our community through quality patient care, advanced medical technology, and dedicated healthcare professionals."
                       style="-fx-text-fill: #444;"/>
            </VBox>

            <!-- Department Contacts -->
            <VBox spacing="15"
                  style="-fx-background-color: white; -fx-background-radius: 10;">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <Label text="Department Contacts">
                    <font>
                        <Font size="18"/>
                    </font>
                </Label>

                <Label text="Quick reference for key hospital departments"
                       style="-fx-text-fill: #777;"/>

                <GridPane hgap="15" vgap="15">

                    <VBox spacing="5"
                          style="-fx-background-color: #f5f7fb; -fx-background-radius: 8;">
                        <padding>
                            <Insets top="15" right="15" bottom="15" left="15"/>
                        </padding>
                        <Label text="IT Support"/>
                        <Label text="ext. 1234"/>
                        <Label text="it@hospital.com"/>
                    </VBox>

                    <VBox GridPane.columnIndex="1" spacing="5"
                          style="-fx-background-color: #f5f7fb; -fx-background-radius: 8;">
                        <padding>
                            <Insets top="15" right="15" bottom="15" left="15"/>
                        </padding>
                        <Label text="Pharmacy"/>
                        <Label text="ext. 1235"/>
                        <Label text="pharmacy@hospital.com"/>
                    </VBox>

                    <VBox GridPane.columnIndex="2" spacing="5"
                          style="-fx-background-color: #f5f7fb; -fx-background-radius: 8;">
                        <padding>
                            <Insets top="15" right="15" bottom="15" left="15"/>
                        </padding>
                        <Label text="Billing"/>
                        <Label text="ext. 1236"/>
                        <Label text="billing@hospital.com"/>
                    </VBox>

                    <VBox GridPane.rowIndex="1" spacing="5"
                          style="-fx-background-color: #f5f7fb; -fx-background-radius: 8;">
                        <padding>
                            <Insets top="15" right="15" bottom="15" left="15"/>
                        </padding>
                        <Label text="Emergency"/>
                        <Label text="ext. 911"/>
                        <Label text="emergency@hospital.com"/>
                    </VBox>

                    <VBox GridPane.rowIndex="1" GridPane.columnIndex="1" spacing="5"
                          style="-fx-background-color: #f5f7fb; -fx-background-radius: 8;">
                        <padding>
                            <Insets top="15" right="15" bottom="15" left="15"/>
                        </padding>
                        <Label text="Administration"/>
                        <Label text="ext. 1000"/>
                        <Label text="admin@hospital.com"/>
                    </VBox>

                    <VBox GridPane.rowIndex="1" GridPane.columnIndex="2" spacing="5"
                          style="-fx-background-color: #f5f7fb; -fx-background-radius: 8;">
                        <padding>
                            <Insets top="15" right="15" bottom="15" left="15"/>
                        </padding>
                        <Label text="Laboratory"/>
                        <Label text="ext. 1237"/>
                        <Label text="lab@hospital.com"/>
                    </VBox>

                </GridPane>
            </VBox>

            <!-- Policy Documents -->
            <VBox spacing="15"
                  style="-fx-background-color: white; -fx-background-radius: 10;">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <Label text="Policy Documents">
                    <font>
                        <Font size="18"/>
                    </font>
                </Label>

                <Label text="Access important internal documents and procedures"
                       style="-fx-text-fill: #777;"/>

                <HBox spacing="20">
                    <Label text="Patient Privacy Policy"/>
                    <Button text="View Document"/>
                </HBox>

                <HBox spacing="20">
                    <Label text="Front Office Procedures"/>
                    <Button text="View Document"/>
                </HBox>

                <HBox spacing="20">
                    <Label text="Emergency Protocols"/>
                    <Button text="View Document"/>
                </HBox>
            </VBox>

            <!-- Hospital Directory -->
            <VBox spacing="10" styleClass="card">

                <Label text="Hospital Directory" styleClass="section-title"/>
                <Label text="Quick reference for locating hospital sections"
                       styleClass="page-subtitle"/>

                <!-- Item -->
                <HBox spacing="15" styleClass="list-item">
                    <Label text="📍" styleClass="icon"/>
                    <VBox spacing="2">
                        <Label text="Emergency Department" styleClass="item-title"/>
                        <Label text="Ground Floor, Wing A" styleClass="item-subtitle"/>
                    </VBox>
                </HBox>
                <Separator/>

                <HBox spacing="15" styleClass="list-item">
                    <Label text="📍" styleClass="icon"/>
                    <VBox spacing="2">
                        <Label text="Outpatient Clinic" styleClass="item-title"/>
                        <Label text="Ground Floor, Wing B" styleClass="item-subtitle"/>
                    </VBox>
                </HBox>
                <Separator/>

                <HBox spacing="15" styleClass="list-item">
                    <Label text="📍" styleClass="icon"/>
                    <VBox spacing="2">
                        <Label text="Radiology" styleClass="item-title"/>
                        <Label text="Ground Floor, Wing C" styleClass="item-subtitle"/>
                    </VBox>
                </HBox>
                <Separator/>

                <HBox spacing="15" styleClass="list-item">
                    <Label text="📍" styleClass="icon"/>
                    <VBox spacing="2">
                        <Label text="Pharmacy" styleClass="item-title"/>
                        <Label text="Ground Floor, Wing D" styleClass="item-subtitle"/>
                    </VBox>
                </HBox>
                <Separator/>

                <HBox spacing="15" styleClass="list-item">
                    <Label text="📍" styleClass="icon"/>
                    <VBox spacing="2">
                        <Label text="ICU" styleClass="item-title"/>
                        <Label text="Second Floor, Wing A" styleClass="item-subtitle"/>
                    </VBox>
                </HBox>
                <Separator/>

                <HBox spacing="15" styleClass="list-item">
                    <Label text="📍" styleClass="icon"/>
                    <VBox spacing="2">
                        <Label text="Operating Rooms" styleClass="item-title"/>
                        <Label text="Second Floor, Wing B" styleClass="item-subtitle"/>
                    </VBox>
                </HBox>
                <Separator/>

                <HBox spacing="15" styleClass="list-item">
                    <Label text="📍" styleClass="icon"/>
                    <VBox spacing="2">
                        <Label text="Laboratory" styleClass="item-title"/>
                        <Label text="First Floor, Wing C" styleClass="item-subtitle"/>
                    </VBox>
                </HBox>
                <Separator/>

                <HBox spacing="15" styleClass="list-item">
                    <Label text="📍" styleClass="icon"/>
                    <VBox spacing="2">
                        <Label text="Administration" styleClass="item-title"/>
                        <Label text="Third Floor, Main Building" styleClass="item-subtitle"/>
                    </VBox>
                </HBox>

            </VBox>

        </VBox>

      
    </content>
</ScrollPane>
