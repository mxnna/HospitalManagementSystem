<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@service.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox styleClass="header-section">
            <Label styleClass="system-title" text="Hospital Management System" />
            <Label styleClass="page-title" text="Service Management" />
            <Label styleClass="page-subtitle" text="Manage hospital services and offerings" />
        </VBox>
    </top>

    <center>
        <VBox spacing="10.0" styleClass="main-content">
            <VBox.margin>
                <Insets top="20.0" left="30.0" right="30.0" bottom="20.0" />
            </VBox.margin>

            <Label styleClass="section-title" text="Available Services" />

            <TableView fx:id="servicesTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="serviceIdCol" prefWidth="120.0" text="Service ID" />
                    <TableColumn fx:id="serviceNameCol" prefWidth="300.0" text="Service Name" />
                    <TableColumn fx:id="departmentCol" prefWidth="200.0" text="Department" />
                    <TableColumn fx:id="feeCol" prefWidth="120.0" text="Fee" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>

