<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import java.lang.String?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane styleClass="root" stylesheets="@appointment.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shahd.hospitalmanagementsystem.AppointmentController">
    
    <!-- Header -->
    <top>
        <VBox styleClass="header-section">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <VBox HBox.hgrow="ALWAYS">
                    <Label styleClass="main-title" text="Appointments Management">
                        <font>
                            <Font name="System Bold" size="28" />
                        </font>
                    </Label>
                    <Label styleClass="subtitle" text="Schedule and manage patient appointments">
                        <font>
                            <Font size="14" />
                        </font>
                    </Label>
                </VBox>
                <Button fx:id="newAppointmentBtn" onAction="#handleNewAppointment" styleClass="btn-primary" text="+ New Appointment" />
            </HBox>
            
            <!-- Tab Bar -->
            <HBox spacing="30" styleClass="tab-bar">
                <padding>
                    <Insets bottom="10" top="20" />
                </padding>
                <Label styleClass="tab-active" text="List View" />
                <Label styleClass="tab-inactive" />
            </HBox>
        </VBox>
    </top>
    
    <!-- Main Content -->
    <center>
        <VBox styleClass="content-section">
            <!-- List Header -->
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="list-header">
                <VBox>
                    <Label styleClass="section-title" text="Appointment List">
                        <font>
                            <Font name="System Bold" size="18" />
                        </font>
                    </Label>
                    <Label styleClass="section-subtitle" text="Manage all scheduled appointments">
                        <font>
                            <Font size="13" />
                        </font>
                    </Label>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="searchField" prefWidth="300" promptText="Search appointments..." styleClass="search-field" />
                <ComboBox fx:id="statusFilter" prefWidth="150" promptText="All Status" styleClass="filter-combo" />
            </HBox>
            
            <!-- Table -->
            <TableView fx:id="appointmentTable" styleClass="appointment-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" prefWidth="120" text="Appointment ID"/>
                    <TableColumn fx:id="patientColumn" prefWidth="180" text="Patient"/>
                    <TableColumn fx:id="doctorColumn" prefWidth="150" text="Doctor"/>
                    <TableColumn fx:id="specialtyColumn" prefWidth="130" text="Specialty"/>
                    <TableColumn fx:id="dateTimeColumn" prefWidth="150" text="Date &amp; Time"/>
                    <TableColumn fx:id="statusColumn" prefWidth="120" text="Status"/>
                    <TableColumn fx:id="actionsColumn" prefWidth="150" text="Actions" />
                </columns>
            </TableView>
        </VBox>
    </center>
    
    <!-- Appointment dialog removed for rework. -->
    
</BorderPane>
