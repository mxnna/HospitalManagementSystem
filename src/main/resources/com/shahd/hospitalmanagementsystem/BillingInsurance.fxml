<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@BillingInsurance.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shahd.hospitalmanagementsystem.BillingInController">
    
    <top>
        <VBox styleClass="header-section">
            <Label styleClass="system-title" text="Hospital Management System" />
            <Label styleClass="page-title" text="Billing &amp; Insurance" />
            <Label styleClass="page-subtitle" text="Manage payments and insurance verification" />
        </VBox>
    </top>
    
    <center>
        <VBox spacing="20.0" styleClass="main-content">
            <VBox.margin>
                <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
            </VBox.margin>
            
            <HBox spacing="10.0" styleClass="tab-navigation">
                <Button fx:id="insuranceVerificationTab" onAction="#showInsuranceVerification" styleClass="tab-button, active-tab" text="Insurance Verification" />
                <Button fx:id="processPaymentTab" onAction="#showProcessPayment" styleClass="tab-button" text="Process Payment" />
                <Button fx:id="pendingBalancesTab" onAction="#showPendingBalances" styleClass="tab-button" text="Pending Balances" />
                <Button fx:id="transactionHistoryTab" onAction="#showTransactionHistory" styleClass="tab-button" text="Transaction History" />
            </HBox>
            
            <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS">
                
                <VBox fx:id="insuranceVerificationView" spacing="20.0" styleClass="content-view">
                    <Label styleClass="section-title" text="Insurance Verification" />
                    <Label styleClass="section-subtitle" text="Verify patient insurance eligibility and coverage" />
                    
                    <GridPane hgap="30.0" styleClass="form-grid" vgap="12.0">
                        <Label styleClass="form-label" text="Patient ID or Name" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <HBox prefWidth="400.0" spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <TextField fx:id="patientIdField" prefHeight="40.0" promptText="Enter patient ID or name" styleClass="form-input" HBox.hgrow="ALWAYS" />
                            <Button prefHeight="40.0" prefWidth="45.0" styleClass="search-button">
                                <graphic>
                                    <Label ellipsisString="search" styleClass="icon-label" text="🔍" />
                                </graphic>
                            </Button>
                        </HBox>
                        
                        <Label styleClass="form-label" text="Insurance Provider" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <ComboBox fx:id="insuranceProviderCombo" prefHeight="40.0" prefWidth="400.0" promptText="Select provider" styleClass="form-input" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        
                        <Label styleClass="form-label" text="Policy Number" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <TextField fx:id="policyNumberField" prefHeight="40.0" prefWidth="400.0" promptText="Enter policy number" styleClass="form-input" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        
                        <Label styleClass="form-label" text="Group Number" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <TextField fx:id="groupNumberField" prefHeight="40.0" prefWidth="400.0" promptText="Enter group number" styleClass="form-input" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <columnConstraints>
                            <ColumnConstraints />
                            <ColumnConstraints />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints />
                            <RowConstraints />
                            <RowConstraints />
                            <RowConstraints />
                        </rowConstraints>
                    </GridPane>
                    
                    <Button fx:id="verifyCoverageBtn" maxWidth="Infinity" onAction="#verifyCoverage" prefHeight="45.0" styleClass="primary-button" text="Verify Coverage" />
                    
                    <VBox fx:id="verificationResult" managed="false" spacing="10.0" styleClass="result-box" visible="false">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label styleClass="success-icon" text="✓" />
                            <Label styleClass="result-title" text="Insurance Verified" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="statusBadge" styleClass="status-badge, active-badge" text="Active" />
                        </HBox>
                        <GridPane hgap="20.0" vgap="8.0">
                            <Label styleClass="result-label" text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <Label fx:id="statusLabel" styleClass="result-value" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                            
                            <Label styleClass="result-label" text="Coverage Type:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <Label fx:id="coverageTypeLabel" styleClass="result-value" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            
                            <Label styleClass="result-label" text="Copay Amount:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                            <Label fx:id="copayAmountLabel" styleClass="result-value" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                            
                            <Label styleClass="result-label" text="Deductible Remaining:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                            <Label fx:id="deductibleLabel" styleClass="result-value" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                            <columnConstraints>
                                <ColumnConstraints />
                                <ColumnConstraints />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />
                            </rowConstraints>
                        </GridPane>
                    </VBox>
                </VBox>
                
                <VBox fx:id="processPaymentView" managed="false" spacing="20.0" styleClass="content-view" visible="false">
                    <Label styleClass="section-title" text="Process Payment" />
                    <Label styleClass="section-subtitle" text="Accept co-pays and patient payments" />
                    
                    <GridPane hgap="30.0" styleClass="form-grid" vgap="12.0">
                        <Label styleClass="form-label" text="Patient" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <HBox prefWidth="400.0" spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <TextField fx:id="paymentPatientField" prefHeight="40.0" promptText="Search patient" styleClass="form-input" HBox.hgrow="ALWAYS" />
                            <Button prefHeight="40.0" prefWidth="45.0" styleClass="search-button">
                                <graphic>
                                    <Label styleClass="icon-label" text="🔍" />
                                </graphic>
                            </Button>
                        </HBox>
                        
                        <Label styleClass="form-label" text="Payment Type" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <ComboBox fx:id="paymentTypeCombo" prefHeight="40.0" prefWidth="400.0" promptText="Select type" styleClass="form-input" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        
                        <Label styleClass="form-label" text="Amount" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <TextField fx:id="amountField" prefHeight="40.0" prefWidth="400.0" styleClass="form-input" text="0.00" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        
                        <Label styleClass="form-label" text="Payment Method" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <ComboBox fx:id="paymentMethodCombo" prefHeight="40.0" prefWidth="400.0" promptText="Select method" styleClass="form-input" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        
                        <Label styleClass="form-label" text="Notes (Optional)" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="4" />
                        <TextArea fx:id="notesArea" prefHeight="80.0" prefRowCount="3" promptText="Payment notes or reference" styleClass="form-input" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="5" />
                        <columnConstraints>
                            <ColumnConstraints />
                            <ColumnConstraints />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints />
                            <RowConstraints />
                            <RowConstraints />
                            <RowConstraints />
                            <RowConstraints />
                            <RowConstraints />
                        </rowConstraints>
                    </GridPane>
                    
                    <HBox spacing="10.0">
                        <Button maxWidth="Infinity" onAction="#processPayment" prefHeight="45.0" styleClass="primary-button" text="Process Payment" HBox.hgrow="ALWAYS" />
                        <Button prefHeight="45.0" prefWidth="150.0" styleClass="secondary-button" text="Print Receipt">
                            <graphic>
                                <Label styleClass="icon-label" text="🖨" />
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>
                
                <VBox fx:id="pendingBalancesView" managed="false" spacing="20.0" styleClass="content-view" visible="false">
                    <Label styleClass="section-title" text="Outstanding Balances" />
                    <Label styleClass="section-subtitle" text="Patients with pending payments" />
                    
                    <TableView fx:id="pendingBalancesTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="invoiceIdCol" prefWidth="100.0" text="Invoice ID" />
                            <TableColumn fx:id="patientCol" prefWidth="150.0" text="Patient" />
                            <TableColumn fx:id="insuranceCol" prefWidth="150.0" text="Insurance" />
                            <TableColumn fx:id="totalAmountCol" prefWidth="120.0" text="Total Amount" />
                            <TableColumn fx:id="copayDueCol" prefWidth="120.0" text="Co-pay Due" />
                            <TableColumn fx:id="statusCol" prefWidth="100.0" text="Status" />
                            <TableColumn fx:id="actionsCol" prefWidth="150.0" text="Actions" />
                        </columns>
                    </TableView>
                </VBox>
                
                <VBox fx:id="transactionHistoryView" managed="false" spacing="20.0" styleClass="content-view" visible="false">
                    <Label styleClass="section-title" text="Recent Transactions" />
                    <Label styleClass="section-subtitle" text="Payment history and receipts" />
                    
                    <TableView fx:id="transactionHistoryTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="transactionIdCol" prefWidth="120.0" text="Transaction ID" />
                            <TableColumn fx:id="patientNameCol" prefWidth="150.0" text="Patient Name" />
                            <TableColumn fx:id="typeCol" prefWidth="120.0" text="Type" />
                            <TableColumn fx:id="amountColHist" prefWidth="100.0" text="Amount" />
                            <TableColumn fx:id="methodCol" prefWidth="120.0" text="Method" />
                            <TableColumn fx:id="dateTimeCol" prefWidth="180.0" text="Date &amp; Time" />
                            <TableColumn fx:id="actionsColHist" prefWidth="100.0" text="Actions" />
                        </columns>
                    </TableView>
                </VBox>
                
            </StackPane>
        </VBox>
    </center>
    
</BorderPane>
