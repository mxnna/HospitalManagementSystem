<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shahd.hospitalmanagementsystem.DashboardController" stylesheets="@dashboard.css">
    <children>
        <VBox spacing="18.0" styleClass="dashboard-content" AnchorPane.topAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.bottomAnchor="10.0">
            <children>
                <HBox spacing="16.0">
                    <children>
                        <VBox styleClass="dashboard-card" spacing="6.0" prefWidth="240.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Appointments Today" styleClass="widget-label" />
                                <Label fx:id="appointmentsCount" style="-fx-font-size:28px; -fx-font-weight:bold; -fx-text-fill:#188ba7;" text="0" />
                            </children>
                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16" />
                            </padding>
                        </VBox>
                        <VBox styleClass="dashboard-card" spacing="6.0" prefWidth="240.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Patients Checked In" styleClass="widget-label" />
                                <Label fx:id="patientsCount" style="-fx-font-size:28px; -fx-font-weight:bold; -fx-text-fill:#188ba7;" text="0" />
                            </children>
                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16" />
                            </padding>
                        </VBox>
                        <VBox styleClass="dashboard-card" spacing="6.0" prefWidth="240.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Doctors On Duty" styleClass="widget-label" />
                                <Label fx:id="doctorsCount" style="-fx-font-size:28px; -fx-font-weight:bold; -fx-text-fill:#188ba7;" text="0" />
                            </children>
                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16" />
                            </padding>
                        </VBox>
                        <VBox styleClass="dashboard-card" spacing="6.0" prefWidth="240.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Emergency Cases" styleClass="widget-label" />
                                <Label fx:id="emergencyCount" style="-fx-font-size:28px; -fx-font-weight:bold; -fx-text-fill:#d9534f;" text="0" />
                            </children>
                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16" />
                            </padding>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="12.0">
                    <children>
                        <Button fx:id="quickNew" text="Schedule New Appointment" HBox.hgrow="ALWAYS" styleClass="primary-button" />
                        <Button fx:id="quickCheckIn" text="Check-In Patient" HBox.hgrow="ALWAYS" styleClass="quick-action-btn" />
                        <Button fx:id="quickSearch" text="Search Patient Record" HBox.hgrow="ALWAYS" styleClass="quick-action-btn" />
                    </children>
                    <VBox.margin>
                        <Insets top="10" bottom="10" />
                    </VBox.margin>
                </HBox>

                <Separator />

                <HBox spacing="12.0" VBox.vgrow="ALWAYS">
                    <children>
                        <StackPane HBox.hgrow="ALWAYS">
                            <children>
                                <VBox spacing="12.0">
                                    <children>
                                        <Label text="Recent Appointments" styleClass="section-title" />
                                        <TableView fx:id="appointmentsTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colApptId" text="ID" prefWidth="80" />
                                                <TableColumn fx:id="colPatient" text="Patient" prefWidth="150" />
                                                <TableColumn fx:id="colDoctor" text="Doctor" prefWidth="150" />
                                                <TableColumn fx:id="colTime" text="Time" prefWidth="140" />
                                                <TableColumn fx:id="colStatus" text="Status" prefWidth="120" />
                                            </columns>
                                        </TableView>
                                    </children>
                                    <padding>
                                        <Insets top="10" right="10" bottom="10" left="10" />
                                    </padding>
                                </VBox>
                            </children>
                        </StackPane>

                        <StackPane HBox.hgrow="ALWAYS">
                            <children>
                                <VBox spacing="12.0">
                                    <children>
                                        <Label text="Emergency Cases" styleClass="section-title" />
                                        <TableView fx:id="emergencyTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colCaseId" text="ID" prefWidth="80" />
                                                <TableColumn fx:id="colCasePatient" text="Patient" prefWidth="150" />
                                                <TableColumn fx:id="colReason" text="Reason" prefWidth="150" />
                                                <TableColumn fx:id="colCaseTime" text="Time" prefWidth="140" />
                                                <TableColumn fx:id="colPriority" text="Priority" prefWidth="120" />
                                            </columns>
                                        </TableView>
                                    </children>
                                    <padding>
                                        <Insets top="10" right="10" bottom="10" left="10" />
                                    </padding>
                                </VBox>
                            </children>
                        </StackPane>
                    </children>
                </HBox>
            </children>
            <VBox.margin>
                <Insets left="8" right="8" />
            </VBox.margin>
        </VBox>
    </children>
</AnchorPane>
